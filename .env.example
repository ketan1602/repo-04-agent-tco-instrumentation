ENVIRONMENT=development

# Any OpenAI-compatible chat API. Fill these in .env (gitignored, never commit it).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Cost per 1 000 tokens (USD). Used to compute token_cost_usd per run. Defaults to 0.005.
LLM_COST_PER_1K_TOKENS=

# Optional: per-run share of shared platform costs (USD). Defaults to 0.
# Set these to allocate your observability/runtime/control overhead per run.
PLATFORM_RUNTIME_COST_PER_RUN=
PLATFORM_OBSERVABILITY_COST_PER_RUN=
PLATFORM_CONTROL_COST_PER_RUN=
